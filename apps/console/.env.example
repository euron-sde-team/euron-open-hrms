# Read at REQUEST time by /env.js, so one built image serves every environment.
# Public API base, including the /api prefix. The console calls /platform/* on it.
API_URL=http://localhost:5005/api
PRODUCT_NAME=Euron Open HRMS
# The tenant app; "Impersonate" opens ${TENANT_URL}/login in a new tab.
TENANT_URL=http://localhost:3410

# Build-time fallbacks for `next dev`:
# NEXT_PUBLIC_API_URL=http://localhost:5005/api
# NEXT_PUBLIC_PRODUCT_NAME=Euron Open HRMS
# NEXT_PUBLIC_TENANT_URL=http://localhost:3410
