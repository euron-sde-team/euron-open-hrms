{
  "name": "@open-hrms/api",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant HRMS API: tenant plane (/api), operator plane (/api/platform) and the background job worker.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts src/cli.ts ../../db/migrate.ts --bundle --platform=node --target=node22 --format=cjs --outdir=dist --entry-names=[name] --external:pg-native --external:@sentry/node --external:web-push --sourcemap",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "eslint src test",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "demo:seed": "tsx src/cli.ts demo:seed",
    "operator:create": "tsx src/cli.ts operator:create"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1061.0",
    "@aws-sdk/client-s3": "^3.1060.0",
    "@aws-sdk/client-secrets-manager": "^3.1061.0",
    "@aws-sdk/client-sesv2": "^3.1061.0",
    "@aws-sdk/s3-request-presigner": "^3.1060.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "kysely": "^0.28.8",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.16",
    "pdfkit": "^0.15.0",
    "pg": "^8.16.3",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pngjs": "^7.0.0",
    "qrcode": "^1.5.4",
    "svg-to-pdfkit": "^0.1.8",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "optionalDependencies": {
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@aws-sdk/client-route-53": "^3.1147.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.15.6",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "esbuild": "^0.24.0",
    "supertest": "^7.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.8"
  }
}
