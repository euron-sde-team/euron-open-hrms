# Read at REQUEST time by /env.js, so one built image serves every environment.
# Public API base, including the /api prefix.
API_URL=http://localhost:5005/api
# Product name shown in titles, the app shell and notifications.
PRODUCT_NAME=Euron Open HRMS

# Build-time fallbacks, only consulted when the runtime values above are absent
# (handy for `next dev` without the env.js route).
# NEXT_PUBLIC_API_URL=http://localhost:5005/api
# NEXT_PUBLIC_PRODUCT_NAME=Euron Open HRMS
